# Base URL of the audit service (POST /audit). Empty uses the labeled cache.
AUDIT_API_BASE=
AUDIT_API_KEY=

# Daily cap for live runs, in USD, from the audit receipt. Cache is free.
MAX_DAILY_USD=3
ESTIMATED_LIVE_USD=0.03

# Live runs per client IP per hour. Cached audits are not counted.
LIVE_RATE_PER_HOUR=40

# Directory of eval/results JSON. Empty searches ../eval/results when present.
EVAL_RESULTS_DIR=

PORT=8080
