# Token Factory. Leave blank to run the recorded Nemotron client.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily. Leave blank to use recorded guideline fixtures.
TAVILY_API_KEY=

# Comma-separated FHIR hosts in addition to localhost and hapi.fhir.org.
FHIR_ALLOWED_HOSTS=
# 1 allows any public host. Private, link-local, and metadata addresses stay blocked.
FHIR_ALLOW_ANY=

FHIR_SERVER_URL=http://127.0.0.1:9090
FHIR_ACCESS_TOKEN=

# 0 returns the rules pipeline only.
CODESENTINEL_VERIFY=1
GUIDELINE_CACHE_DIR=.cache/guidelines

# Reserved for a later daily budget guard. This service does not enforce it yet.
MAX_DAILY_USD=3
